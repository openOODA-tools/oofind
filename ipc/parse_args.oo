// # Parse Arguments - Command Line Flag Decoupling
//
// Logline: Decodes command line arguments into structured options and criteria.
//
// Setup: Pure argument decoding. Populates FindOpts with validated search parameters.
//
// Beats:
//   1. Parse matching and traversal flags with arity checking.
//   2. Accumulate positional root paths or default to current directory.
//   3. Validate flag invariants and fail closed on unrecognized options.

import "match/find_criteria.oo";
import "find_opts.oo";

fn parse_digit_val(c: String) -> Int {
    let b: Int = byte_at(c, 0);
    if b >= 48 && b <= 57 {
        return b - 48;
    }
    return 0;
}

fn parse_integer_string(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut val: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(char_at(s, i), 0);
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48);
        } else {
            return val;
        }
        i = i + 1;
    }
    return val;
}

fn parse_size_bytes(raw: String) -> Int {
    let s: String = str_trim(raw);
    let n: Int = chars_len(s);
    if n == 0 { return -1; }
    let last_char: String = char_at(s, n - 1);
    let mut mult: Int = 1;
    let mut len: Int = n;
    if last_char == "k" || last_char == "K" {
        mult = 1024;
        len = n - 1;
    } else if last_char == "M" || last_char == "m" {
        mult = 1048576;
        len = n - 1;
    } else if last_char == "G" || last_char == "g" {
        mult = 1073741824;
        len = n - 1;
    } else if last_char == "c" {
        mult = 1;
        len = n - 1;
    }
    let num_str: String = str_slice(s, 0, len);
    return parse_integer_string(num_str) * mult;
}

pub fn parse_cli_args(args: List[String]) -> FindOpts {
    let mut opts: FindOpts = find_opts_default();
    let mut crit: FindCriteria = opts.criteria;
    let n: Int = list_len(args);
    let mut i: Int = 0;

    while i < n {
        let arg: String = list_get(args, i);

        if arg == "-h" || arg == "--help" {
            opts.help_mode = true;
            return opts;
        } else if arg == "-v" || arg == "-V" || arg == "--version" {
            opts.version_mode = true;
            return opts;
        } else if arg == "--mcp" {
            opts.mcp_mode = true;
            return opts;
        } else if arg == "-print0" {
            opts.print_null = true;
        } else if arg == "--json" {
            opts.json_output = true;
        } else if arg == "--exit-code" {
            opts.exit_code_mode = true;
        } else if arg == "-hidden" || arg == "--hidden" {
            crit.hidden = true;
        } else if arg == "--no-ignore" {
            opts.respect_ignore = false;
        } else if arg == "-empty" {
            crit.empty_only = true;
        } else if arg == "-name" {
            if i + 1 >= n { opts.error_msg = "missing pattern after -name"; return opts; }
            i = i + 1;
            crit.name_pattern = list_get(args, i);
        } else if arg == "-iname" {
            if i + 1 >= n { opts.error_msg = "missing pattern after -iname"; return opts; }
            i = i + 1;
            crit.iname_pattern = list_get(args, i);
        } else if arg == "-type" {
            if i + 1 >= n { opts.error_msg = "missing type after -type"; return opts; }
            i = i + 1;
            crit.type_filter = list_get(args, i);
        } else if arg == "-e" || arg == "-extension" || arg == "--extension" {
            if i + 1 >= n { opts.error_msg = "missing extension after " + arg; return opts; }
            i = i + 1;
            crit.extension = list_get(args, i);
        } else if arg == "-maxdepth" || arg == "--max-depth" {
            if i + 1 >= n { opts.error_msg = "missing depth after " + arg; return opts; }
            i = i + 1;
            crit.max_depth = parse_integer_string(list_get(args, i));
        } else if arg == "-mindepth" || arg == "--min-depth" {
            if i + 1 >= n { opts.error_msg = "missing depth after " + arg; return opts; }
            i = i + 1;
            crit.min_depth = parse_integer_string(list_get(args, i));
        } else if arg == "-size" {
            if i + 1 >= n { opts.error_msg = "missing size after -size"; return opts; }
            i = i + 1;
            let sz_arg: String = list_get(args, i);
            if chars_len(sz_arg) > 0 {
                if char_at(sz_arg, 0) == "+" {
                    crit.min_size = parse_size_bytes(str_slice(sz_arg, 1, chars_len(sz_arg)));
                } else if char_at(sz_arg, 0) == "-" {
                    crit.max_size = parse_size_bytes(str_slice(sz_arg, 1, chars_len(sz_arg)));
                } else {
                    let exact: Int = parse_size_bytes(sz_arg);
                    crit.min_size = exact;
                    crit.max_size = exact;
                }
            }
        } else if str_starts_with(arg, "-") {
            opts.error_msg = "unknown predicate or option: " + arg;
            return opts;
        } else {
            opts.roots = list_push(opts.roots, arg);
        }
        i = i + 1;
    }

    if list_len(opts.roots) == 0 {
        opts.roots = list_push(opts.roots, ".");
    }

    opts.criteria = crit;
    return opts;
}
